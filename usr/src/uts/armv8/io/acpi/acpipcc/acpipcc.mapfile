$mapfile_version 2

SYMBOL_VERSION ILLUMOSprivate {
    global:

	# DDI Interfaces
	_fini;
	_init;
	_info;

	# Module tunables
	pcc_strictness;

	# Module public interface
	pcc_chan_get;
	pcc_chan_txn_begin;
	pcc_chan_write32;
	pcc_chan_write64;
	pcc_chan_txn_commit;
	pcc_chan_read32;
	pcc_chan_read64;
	pcc_chan_txn_end;
	pcc_chan_put;

    local:
	*;
};
