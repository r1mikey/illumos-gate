<include global_zone_only_component>
set name=pkg.fmri value=pkg:/system/kernel/platform/armh-sbbr@$(PKGVERS)
set name=pkg.summary value="Support for Arm SBBR aarch64"
set name=info.classification value=org.opensolaris.category.2008:System/Core
set name=org.illumos.for-arch value=aarch64
dir  path=platform/ARMH,sbbr
dir  path=platform/ARMH,sbbr/kernel
dir  path=platform/ARMH,sbbr/kernel/$(ARCH)
file path=platform/ARMH,sbbr/kernel/$(ARCH)/unix mode=0755 \
    pkg.depend.bypass-generate=dtracestubs
dir  path=platform/ARMH,sbbr/kernel/misc
dir  path=platform/ARMH,sbbr/kernel/misc/$(ARCH)
file path=platform/ARMH,sbbr/kernel/misc/$(ARCH)/platmod mode=0755
license lic_CDDL license=lic_CDDL
